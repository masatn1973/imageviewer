<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.masatn1973.ImageViewer</id>
  <name translatable="yes">Image Viewer</name>
  <summary translatable="yes">Folder-oriented thumbnail image browser</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.masatn1973">
    <name>masatn</name>
  </developer>
  <launchable type="desktop-id">io.github.masatn1973.ImageViewer.desktop</launchable>
  <description>
    <p translatable="yes">
        ImageViewer is a folder-oriented thumbnail browser for quickly browsing image collections.
        It is built with GTK4 and libadwaita and supports common image formats.
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
        <image>https://raw.githubusercontent.com/masatn1973/imageviewer/main/screenshots/image1.png</image>
    </screenshot>
    <screenshot>
        <image>https://raw.githubusercontent.com/masatn1973/imageviewer/main/screenshots/image2.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/masatn1973/imageviewer</url>
  <url type="bugtracker">https://github.com/masatn1973/imageviewer/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.6" date="2026-06-11">
      <description>
        <ul>
        <li translatable="yes">Add video playback support.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.5" date="2026-06-08">
      <description>
        <ul>
        <li translatable="yes">EXIF information display is now supported.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.4" date="2026-06-05">
      <description>
        <ul>
        <li translatable="yes">Image rotation is now supported.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.3" date="2026-06-03">
      <description>
        <ul>
        <li translatable="yes">Added status bar.</li>
        <li translatable="yes">Supports Home, End, PageUp, PageDown keys.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2026-06-01">
      <description>
        <ul>
        <li translatable="yes">Supports vim like keyboard operation. (h, j, k, l)</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-05-30">
      <description>
        <ul>
        <li translatable="yes">Supports .bmp and .tiff file format.</li>
        <li translatable="yes">Support Left and Right arrow key for view Previous and Next image.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-05-26">
      <description>
        <p translatable="yes">Initial release</p>
      </description>
    </release>
  </releases>
</component>
