<component type="desktop-application">
  <id>jp.co.masatn.ImageViewer</id>
  <name translatable="yes">Image Viewer</name>
  <summary translatable="yes">Browse and view image files</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
    <developer id="jp.co.masatn">
