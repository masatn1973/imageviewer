[Desktop Entry]
Name=Image Viewer
Comment=Folder-oriented thumbnail image browser
Exec=imageviewer %f
Icon=io.github.masatn2026.ImageViewer
Terminal=false
Type=Application
Categories=Graphics;
Keywords=GTK;
StartupNotify=true
DBusActivatable=true
MimeType=image/jpeg;image/jpg;image/png;image/gif;image/webp;image/bmp;image/tiff;image/svg+xml;
