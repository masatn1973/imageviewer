#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:89
msgid "Fixed an issue where no sound was playing when videos were played."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:96
msgid "Add video playback support."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:103
