#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:13
msgid ""
"ImageViewer is a folder-oriented thumbnail browser for quickly browsing "
"image collections. It is built with GTK4 and libadwaita and supports common "
"image formats."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:34
msgid ""
"Modified the system to monitor the “Pictures” folder and update thumbnails "
"whenever images are added or deleted."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:41
msgid "Support image sorting."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:42
msgid "Support reload thumbnails."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:43
msgid ""
"Made it so that the window size is remembered when you close the image view "
"or thumbnail window."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:44
msgid "Removed the video playback feature."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:51
msgid "Support Zoom In/Out."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:58
msgid "Support slideshow."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:65
