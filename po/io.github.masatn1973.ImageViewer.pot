msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:43
#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:51
msgid "Performed a refactoring. No features were added or removed."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:44
msgid "Fixed it so that when you zoom in, it zooms to the correct position."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:58
msgid ""
"Modified the system to monitor the “Pictures” folder and update thumbnails "
"whenever images are added or deleted."
msgstr ""

#: data/io.github.masatn1973.ImageViewer.metainfo.xml.in:65
msgid "Support image sorting."
msgstr ""

